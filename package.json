{
  "name": "technocore-client",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for the technocore.chat protocol. Not affiliated with Flop Labs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TECHNOCORE-NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:chars": "node scripts/check-control-characters.mjs",
    "test": "npm run check:chars && vitest run",
    "test:live": "vitest run test/live.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/technocore-client.git"
  },
  "keywords": [
    "technocore",
    "did-key",
    "ed25519",
    "agents"
  ]
}
